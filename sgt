-- 🌙 AUTO HOP SERVER (EMPTY SERVER PRIORITY) - V5.4 🌙
repeat task.wait() until game:IsLoaded()
repeat task.wait() until game.Players and game.Players.LocalPlayer
--[[ ⚙️ CONFIG ]]
local TIMEOUT_SECONDS = 200
local DAMAGE_COOLDOWN = 60
local SCRIPT_DEBUG = false
local BELI_NAME = "Beli"
local FRAG_NAME = "Fragments"

--[[ ⚙️ SERVICES ]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TeleportService = game:GetService("TeleportService")
local HttpService = game:GetService("HttpService")
local StarterGui = game:GetService("StarterGui")

local localPlayer = Players.LocalPlayer
local PLACE_ID = game.PlaceId

--[[ ⚙️ STATE ]]
local autoHopEnabled = true
local hopCount = 0
local damageDetected = false
local beliIncreased = false
local fragDecreased = false
local shouldSkipHop = false
local lastDamageTime = 0

--[[ 🪶 DEBUG ]]
local function debugPrint(...)
	if SCRIPT_DEBUG then print("[AutoHop]", ...) end
end

local function notify(title, text)
	pcall(function()
		StarterGui:SetCore("SendNotification", {
			Title = title,
			Text = text,
			Duration = 4
		})
	end)
end

--[[ 🌐 SAFE REQUEST ]]
local function safeRequest(req)
	if syn and syn.request then return syn.request(req)
	elseif http and http.request then return http.request(req)
	elseif request then return request(req)
	elseif http_request then return http_request(req)
	end
end

--[[ 🔎 FIND EMPTY SERVER (ƯU TIÊN SERVER TRỐNG, RETRY KHÔNG COOLDOWN) ]]
local function findLowPlayerServer()
	while true do
		local url = ("https://games.roblox.com/v1/games/%s/servers/Public?sortOrder=Asc&limit=100"):format(PLACE_ID)
		local r = safeRequest({
			Url = url,
			Method = "GET",
			Headers = {["Accept"] = "application/json"}
		})

		if r and r.Body then
			local success, data = pcall(function()
				return HttpService:JSONDecode(r.Body)
			end)

			if success and data and data.data then
				local lowestServer = nil
				local lowestCount = math.huge

				for _, s in ipairs(data.data) do
					if s.playing < s.maxPlayers and s.id ~= game.JobId then
						if s.playing < lowestCount then
							lowestCount = s.playing
							lowestServer = s.id
						end
					end
				end

				if lowestServer then
					debugPrint("Tìm thấy server ít người:", lowestCount)
					return lowestServer
				end
			end
		end

		-- ❗ KHÔNG COOLDOWN – tìm lại ngay
		debugPrint("Không tìm được server low player → tìm lại ngay...")
		task.wait(0.5)
	end
end

--[[ 🚀 HOP SERVER ]]
local function hopServer()
	debugPrint("Không có hoạt động trong thời gian chờ → Hop sang server ít người...")
	local sid = findLowPlayerServer()
	if sid then
		pcall(function()
			TeleportService:TeleportToPlaceInstance(PLACE_ID, sid, localPlayer)
		end)
	else
		debugPrint("Không tìm thấy server phù hợp, teleport ngẫu nhiên.")
		pcall(function()
			TeleportService:Teleport(PLACE_ID, localPlayer)
		end)
	end
end
--[[ 🚀 HOP SERVER ]]
local function hopServer()
	local sid, isEmpty = findLowPlayerServer()
	if sid then
		local msg = isEmpty and "🚀 Đang chuyển sang server TRỐNG..." or "🚀 Đang chuyển sang server ≤2 người..."
		notify("AutoHop", msg)
		debugPrint(msg, sid)
		pcall(function() TeleportService:TeleportToPlaceInstance(PLACE_ID, sid, localPlayer) end)
	else
		debugPrint("Không tìm thấy server phù hợp. Teleport random.")
		pcall(function() TeleportService:Teleport(PLACE_ID, localPlayer) end)
	end
end

--[[ 🧮 GET STAT VALUE ]]
local function getStat(name)
	local stats = localPlayer:FindFirstChild("leaderstats")
	if stats then
		local val = stats:FindFirstChild(name)
		if val ~= nil then
			return tonumber(val.Value) or 0
		end
	end
	return 0
end

--[[ ⚔️ DAMAGE WATCHER ]]
local function watchDamageRemotes()
	for _, v in pairs(ReplicatedStorage:GetDescendants()) do
		if v:IsA("RemoteEvent") and (v.Name:lower():find("damage") or v.Name:lower():find("hit")) then
			v.OnClientEvent:Connect(function()
				damageDetected = true
				lastDamageTime = tick()
				autoHopEnabled = false
				debugPrint("Phát hiện gây damage → tạm dừng AutoHop")
			end)
		end
	end
	ReplicatedStorage.DescendantAdded:Connect(function(v)
		if v:IsA("RemoteEvent") and (v.Name:lower():find("damage") or v.Name:lower():find("hit")) then
			v.OnClientEvent:Connect(function()
				damageDetected = true
				lastDamageTime = tick()
				autoHopEnabled = false
				debugPrint("Phát hiện gây damage (mới) → tạm dừng AutoHop")
			end)
		end
	end)
end

