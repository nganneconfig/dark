-- 🌙 AUTO HOP SERVER (EMPTY SERVER PRIORITY) - V5.5 🌙
repeat task.wait() until game:IsLoaded()
repeat task.wait() until game.Players and game.Players.LocalPlayer

--[[ ⚙️ CONFIG ]]
local TIMEOUT_SECONDS = 200
local DAMAGE_COOLDOWN = 60
local SCRIPT_DEBUG = false
local BELI_NAME = "Beli"
local FRAG_NAME = "Fragments"
local MAX_PLAYER_TARGET = 5 -- ưu tiên server <= 5 người

--[[ ⚙️ SERVICES ]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TeleportService = game:GetService("TeleportService")
local HttpService = game:GetService("HttpService")
local StarterGui = game:GetService("StarterGui")

local localPlayer = Players.LocalPlayer
local PLACE_ID = game.PlaceId
local API = "https://games.roblox.com/v1/games/"

--[[ ⚙️ STATE ]]
local autoHopEnabled = true
local hopCount = 0
local damageDetected = false
local beliIncreased = false
local fragDecreased = false
local shouldSkipHop = false
local lastDamageTime = 0

--[[ 🪶 DEBUG ]]
local function debugPrint(...)
	if SCRIPT_DEBUG then
		print("[AutoHop]", ...)
	end
end

local function notify(title, text)
	pcall(function()
		StarterGui:SetCore("SendNotification", {
			Title = title,
			Text = text,
			Duration = 4
		})
	end)
end

--[[ 🌐 SAFE REQUEST ]]
local function safeRequest(req)
	if syn and syn.request then return syn.request(req)
	elseif http and http.request then return http.request(req)
	elseif request then return request(req)
	elseif http_request then return http_request(req)
	end
end

--[[ 🔎 LIST SERVERS ]]
local function listServers(cursor)
	local url = API .. PLACE_ID .. "/servers/Public?sortOrder=Asc&limit=100"
	if cursor then
		url = url .. "&cursor=" .. cursor
	end

	local r = safeRequest({
		Url = url,
		Method = "GET",
		Headers = {["Accept"] = "application/json"}
	})

	if not r or not r.Body then return nil end
	return HttpService:JSONDecode(r.Body)
end

--[[ 🔎 FIND LOW PLAYER SERVERS ]]
local function findLowPlayerServers()
	local serversFound = {}
	local cursor = nil

	repeat
		local page = listServers(cursor)
		if not page or not page.data then break end

		for _, s in ipairs(page.data) do
			if s.id ~= game.JobId and s.playing < s.maxPlayers then
				table.insert(serversFound, {
					id = s.id,
					count = s.playing
				})
			end
		end

		cursor = page.nextPageCursor
	until not cursor

	table.sort(serversFound, function(a, b)
		return a.count < b.count
	end)

	return serversFound
end

--[[ 🚀 HOP SERVER (NO COOLDOWN - RETRY) ]]
local function hopServer()
	notify("AutoHop", "🔍 Đang tìm server ít người...")
	debugPrint("Bắt đầu tìm server low player")

	while autoHopEnabled do
		local servers = findLowPlayerServers()

		for _, s in ipairs(servers) do
			if s.count <= MAX_PLAYER_TARGET then
				debugPrint("Thử hop server:", s.id, "Players:", s.count)

				local success = pcall(function()
					TeleportService:TeleportToPlaceInstance(PLACE_ID, s.id, localPlayer)
				end)

				if success then
					debugPrint("Teleport thành công:", s.id)
					return
				else
					debugPrint("Server full / lỗi → thử server khác")
					task.wait(0.2)
				end
			end
		end

		debugPrint("Không có server phù hợp → reload danh sách")
		task.wait(1) -- nghỉ rất ngắn, KHÔNG cooldown
	end
end

--[[ 🧮 GET STAT ]]
local function getStat(name)
	local stats = localPlayer:FindFirstChild("leaderstats")
	if stats then
		local val = stats:FindFirstChild(name)
		if val then
			return tonumber(val.Value) or 0
		end
	end
	return 0
end

--[[ ⚔️ DAMAGE WATCHER ]]
local function watchDamageRemotes()
	for _, v in pairs(ReplicatedStorage:GetDescendants()) do
		if v:IsA("RemoteEvent") and (v.Name:lower():find("damage") or v.Name:lower():find("hit")) then
			v.OnClientEvent:Connect(function()
				damageDetected = true
				lastDamageTime = tick()
				autoHopEnabled = false
				debugPrint("Phát hiện damage → dừng AutoHop")
			end)
		end
	end
end

--[[ 🧩 WATCH STATS ]]
local function watchPlayerStats()
	local beliStart = getStat(BELI_NAME)
	local fragStart = getStat(FRAG_NAME)

	local stats = localPlayer:WaitForChild("leaderstats", 10)
	if not stats then return end

	local beliObj = stats:FindFirstChild(BELI_NAME)
	local fragObj = stats:FindFirstChild(FRAG_NAME)

	if beliObj then
		beliObj.Changed:Connect(function()
			if tonumber(beliObj.Value) > beliStart then
				autoHopEnabled = false
				shouldSkipHop = true
				StatusLabel.Text = "💰 Beli tăng → Dừng AutoHop"
			end
		end)
	end

	if fragObj then
		fragObj.Changed:Connect(function()
			if tonumber(fragObj.Value) < fragStart then
				autoHopEnabled = false
				shouldSkipHop = true
				StatusLabel.Text = "💎 Fragment giảm → Dừng AutoHop"
			end
		end)
	end
end

--[[ ⏳ MAIN LOOP ]]
spawn(function()
	watchPlayerStats()
	watchDamageRemotes()

	while true do
		task.wait(1)

		if not autoHopEnabled then
			continue
		end

		shouldSkipHop = false
		local elapsed = 0

		while elapsed < TIMEOUT_SECONDS do
			task.wait(1)
			elapsed += 1

			if not autoHopEnabled then break end
			if damageDetected or beliIncreased or fragDecreased then
				shouldSkipHop = true
				break
			end
		end

		if autoHopEnabled and not shouldSkipHop then
			hopCount += 1
			hopServer()
		end

		if damageDetected then
			while tick() - lastDamageTime < DAMAGE_COOLDOWN do
				task.wait(1)
			end
			damageDetected = false
			autoHopEnabled = true
			notify("AutoHop", "✅ Hết cooldown → bật lại AutoHop")
		end
	end
end) 
