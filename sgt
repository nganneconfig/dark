local function updatePlayerCount()
	PlayerLabel.Text = "👥 Server: "..#Players:GetPlayers().."/"..Players.MaxPlayers
end
updatePlayerCount()
Players.PlayerAdded:Connect(updatePlayerCount)
Players.PlayerRemoving:Connect(updatePlayerCount)

--[[ ⏳ MAIN ]]
spawn(function()
	watchDamageRemotes()

	while true do
		task.wait(1)
		updatePlayerCount()

		if not autoHopEnabled then continue end

		local t = 0
		while t < TIMEOUT_SECONDS and autoHopEnabled do
			StatusLabel.Text = "⏳ Hop sau "..(TIMEOUT_SECONDS - t).."s"
			task.wait(1)
			t += 1
			if damageDetected then break end
		end

		if autoHopEnabled and not damageDetected then
			hopCount += 1
			HopLabel.Text = "🔁 Đã hop: "..hopCount
			hopServer()
		end

		if damageDetected then
			while tick() - lastDamageTime < DAMAGE_COOLDOWN do task.wait(1) end
			damageDetected = false
			autoHopEnabled = true
			StatusLabel.Text = "✅ Hết cooldown → AutoHop bật lại"
		end
	end
end) 
