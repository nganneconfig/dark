local function updatePlayerCount()
	local current = #Players:GetPlayers()
	local max = Players.MaxPlayers or "?"
	PlayerCountLabel.Text = string.format("👥 Server: %d/%s người", current, max)
end
updatePlayerCount()
Players.PlayerAdded:Connect(updatePlayerCount)
Players.PlayerRemoving:Connect(updatePlayerCount)

--[[ 🧩 WATCH STATS ]]
local function watchPlayerStats()
	local beliStart = getStat(BELI_NAME)
	local fragStart = getStat(FRAG_NAME)

	local stats = localPlayer:WaitForChild("leaderstats", 10)
	if not stats then return end

	local beliObj = stats:FindFirstChild(BELI_NAME)
	local fragObj = stats:FindFirstChild(FRAG_NAME)

	if beliObj then
		beliObj.Changed:Connect(function()
			local cur = tonumber(beliObj.Value) or 0
			if cur > beliStart then
				beliIncreased = true
				shouldSkipHop = true
				autoHopEnabled = false
				StatusLabel.Text = "💰 Beli tăng → Dừng AutoHop"
			end
		end)
	end

	if fragObj then
		fragObj.Changed:Connect(function()
			local cur = tonumber(fragObj.Value) or 0
			if cur < fragStart then
				fragDecreased = true
				shouldSkipHop = true
				autoHopEnabled = false
				StatusLabel.Text = "💎 Fragments giảm → Dừng AutoHop"
			end
		end)
	end
end

--[[ ⏳ MAIN LOOP ]]
spawn(function()
	watchPlayerStats()
	watchDamageRemotes()

	while true do
		task.wait(1)
		updatePlayerCount()

		if not autoHopEnabled then
			continue
		end

		shouldSkipHop = false
		local elapsed = 0
		while elapsed < TIMEOUT_SECONDS do
			task.wait(1)
			elapsed += 1
			updatePlayerCount()

			if not autoHopEnabled then
				StatusLabel.Text = "⏸ AutoHop đã bị dừng bởi người dùng."
				break
			end

			if beliIncreased or fragDecreased or damageDetected then
				shouldSkipHop = true
				StatusLabel.Text = "⏸ Phát hiện hoạt động → Dừng AutoHop"
				break
			end

			StatusLabel.Text = string.format("⏳ Tự động hop sau: %ds", TIMEOUT_SECONDS - elapsed)
		end

		if not shouldSkipHop and autoHopEnabled then
			hopCount += 1
			HopLabel.Text = "🔁 Đã hop: " .. hopCount .. " lần"
			StatusLabel.Text = "🚀 Không phát hiện hoạt động → Hop server trống hoặc ≤2 người..."
			hopServer()
		end

		-- ⏱️ Cooldown
		if damageDetected then
			local remaining = DAMAGE_COOLDOWN - (tick() - lastDamageTime)
			while remaining > 0 and damageDetected do
				StatusLabel.Text = string.format("🕒 Cooldown: %.0fs còn lại...", remaining)
				task.wait(1)
				remaining = DAMAGE_COOLDOWN - (tick() - lastDamageTime)
			end
		end

		if damageDetected and (tick() - lastDamageTime) >= DAMAGE_COOLDOWN then
			damageDetected = false
			autoHopEnabled = true
			StatusLabel.Text = "✅ Hết cooldown → AutoHop bật lại"
			notify("AutoHop", "✅ Cooldown đã kết thúc, bật lại AutoHop.")
		end
	end
end)  
